PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/fintrack
CLIENT_URL=http://localhost:5173
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_REFRESH_EXPIRES=7d

# Optional — all three features below work with zero setup and degrade
# gracefully if these are left blank.
#
# Stock price lookups for the Investments module (crypto works with no
# key via CoinGecko). Get a free key at https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# AI-powered Insights (summaries + Q&A). Without either of these, Insights
# falls back to rule-based summaries/answers automatically.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Outbound email for password resets (FR-AUTH-05) and bill reminders
# (FR-BILL-04). Without SMTP_HOST set, emails are logged to the server
# console instead of sent — the reset/reminder flows still work end to
# end for local development.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=FinTrack <no-reply@fintrack.app>

# Browser push notifications for bill/budget/goal/anomaly alerts (Settings >
# Push notifications). These aren't a third-party API key — they're a
# self-generated keypair identifying this server to the browsers' push
# services. A working pair is filled in below so push works immediately in
# local dev; generate your own for a real deployment with:
#   npx web-push generate-vapid-keys
# Without these set, subscribing shows a "not configured" notice and every
# other feature is unaffected.
VAPID_PUBLIC_KEY=BO9-0NwjKYbzq8nJqi2UkjC2iba5H7w1RTuWI-tdKOzkwDBrmR4viVYmybsAlkFpNORf-_RHLnWygHSFzgNP4zQ
VAPID_PRIVATE_KEY=_YYItYEsDtpXXjjKhnwVH_ulCO3xmIUoDpOqgRlPL3w
VAPID_SUBJECT=mailto:no-reply@fintrack.app

# Premium upgrade (Settings/Sidebar "Upgrade Now"), paid via Razorpay
# Checkout. Sign up at https://dashboard.razorpay.com and use your test-mode
# key pair — no approval step needed to start testing. Without these set,
# clicking "Upgrade Now" shows a "not configured" notice instead of failing.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_CURRENCY=INR

# Three plan tiers shown in the upgrade modal, priced by commitment length
# (all three unlock the same features). Amount is in the smallest unit of
# the currency (paise for INR). Defaults below are ₹99/₹199/₹499 for
# 1/3/12 months — override any of them independently if you want different
# pricing.
RAZORPAY_PLAN_MONTHLY_AMOUNT=9900
RAZORPAY_PLAN_QUARTERLY_AMOUNT=19900
RAZORPAY_PLAN_YEARLY_AMOUNT=49900

# Razorpay webhooks (Dashboard -> Settings -> Webhooks -> add
# https://<your-domain>/api/webhooks/razorpay, subscribe to whichever
# events you want visibility into e.g. payment.captured, payment.failed,
# refund.processed). The secret you set there must match this value —
# it's how the endpoint verifies a call actually came from Razorpay.
# Logged in the admin panel's Webhooks tab; without this set, incoming
# webhook calls are still logged but always show as unverified.
RAZORPAY_WEBHOOK_SECRET=

# Admin panel (/admin) — a single, hardcoded set of credentials kept fully
# separate from customer accounts (there's no "admin" row in the User
# collection at all). Without all three of these set, the admin panel
# reports "not configured" instead of failing. Generate a fresh secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_JWT_SECRET=
ADMIN_JWT_EXPIRES=12h
